// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =======================
// MASTER DATA
// =======================

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Akan di-hash untuk MVP
  name      String
  photo     String?  // URL foto profil
  email     String?  // Email untuk fitur lupa password
  role      String   // "ADMIN", "SPV", "AFA", "FO", "INTERN", dsb
  phone     String?  // Nomor WhatsApp (digunakan untuk notifikasi WAHA)
  isActive  Boolean  @default(true)
  
  // Self-Relation untuk AFA -> FO
  afaId     String?
  afa       User?    @relation("AfaToFo", fields: [afaId], references: [id])
  fos       User[]   @relation("AfaToFo")

  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([afaId])

  // Relasi Transaksional
  ledgers           Ledger[]
  sampleLedgers     SampleLedger[]
  requestsAsFo      Request[]  @relation("FoRequests")
  requestsAsAfa     Request[]  @relation("AfaApprovals")
  stockOpnames      StockOpname[]

  // Laporan Aktivitas
  customerBehaviors CustomerBehavior[]
  visitKios         VisitKios[]
  farmerGatherings  FarmerGathering[]
  visitCompanies    VisitCompany[]
  contentVideos     ContentVideo[]
  spotDemplot       SpotDemplot[]

  // Notifikasi
  notifications     Notification[]

  // SOP
  sops              Sop[]

  // Open API keys
  apiKeys           ApiKey[]
}

model Store {
  id               String   @id @default(cuid())
  accurateId       String?  @unique  // customer no dari Accurate
  name             String
  code             String?           // kode toko / no customer
  address          String?
  latitude         Float?
  longitude        Float?
  phone            String?
  notes            String?
  defaultSalesman  String?           // nama salesman default dari Accurate (e.g. "Busdev")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model KpiTarget {
  id              String   @id @default(cuid())
  areaId          String?  // null = "Tanpa Area" (target global/unassigned)
  area            Area?    @relation(fields: [areaId], references: [id])
  
  month           Int      // 1-12
  year            Int
  
  targetDemoPlot  Int      @default(0)
  targetVisitKios Int      @default(0)
  targetGathering Int      @default(0)
  targetCompany   Int      @default(0)
  targetBehavior  Int      @default(0)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([areaId, month, year])
}

model Area {
  id         String       @id @default(cuid())
  name       String
  users      User[]
  coverages  AreaCoverage[]
  kpiTargets KpiTarget[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model AreaCoverage {
  id            String   @id @default(cuid())
  areaId        String
  area          Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  kabupatenName String   // nama kabupaten/kota lowercase & normalized
  createdAt     DateTime @default(now())

  @@unique([areaId, kabupatenName])
}

// Permintaan pembuatan akun dari calon user (self-register)
model AccountRequest {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   // "AFA", "FO"
  email     String?  // Email dari calon user
  areaName  String?  // Area yang diminta (nama teks)
  afaName   String?  // Nama AFA supervisor (untuk FO)
  notes     String?  // Catatan dari calon user
  status    String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  rejectReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Konfigurasi sistem (WAHA, nomor WA per role, dll)
model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique  // "waha_base_url", "waha_api_key", "waha_session", "wa_spv", "wa_fam", "wa_whm"
  value     String
  label     String?  // Label user-friendly untuk UI admin
  updatedAt DateTime @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  code            String?
  accurateId      String?  @unique  // no_barang / SKU dari Accurate Online
  name            String
  description     String?
  unit            String   // Satuan kemasan: PCS, Btl, Bks, Box, Sak, gl, Pack, Rol
  unitGramasi     String?  // Satuan isi per kemasan: "ml" atau "gr"
  gramasiPerUnit  Float?   // Volume/berat per kemasan, misal 500 (artinya 500ml/Btl)
  spvStock        Float?   // Stok SPV dari Accurate (dalam satuan kemasan)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ledgers           Ledger[]
  sampleLedgers     SampleLedger[]
  requestDetails    RequestDetail[]
  demoPlotDetails   DemoPlotDetail[]
  opnameDetails     OpnameDetail[]
  spotDemplotDetails SpotDemplotDetail[]
  contentVideoProducts ContentVideoProduct[]
}

model Farmer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  area      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests  Request[]
  demoPlots DemoPlot[]
}

// =======================
// CORE ENGINE: LEDGER
// =======================

model Ledger {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  
  transactionType String   // "STOCK_IN_GUDANG", "TRANSFER_TO_FO", "RECEIVE_FROM_AFA", "USAGE_DEMOPLOT", "DIRECT_USAGE_AFA", "ADJUSTMENT_PLUS", "ADJUSTMENT_MINUS"
  quantity        Float    // Nilai bisa positif (masuk) atau negatif (keluar)
  referenceId     String?  // ID dari Request / DemoPlot / StockOpname
  snapshotAreaId  String?  // areaId user saat transaksi terjadi
  notes           String?
  
  createdAt       DateTime @default(now())

  @@index([userId, productId])
  @@index([userId, createdAt])
  @@index([referenceId])
  @@index([createdAt])
}

// =======================
// TRANSACTIONAL MODELS
// =======================

model Request {
  id             String   @id @default(cuid())
  foId           String
  fo             User     @relation("FoRequests", fields: [foId], references: [id])
  afaId          String?
  afa            User?    @relation("AfaApprovals", fields: [afaId], references: [id])
  farmerId       String?
  farmer         Farmer?  @relation(fields: [farmerId], references: [id])
  
  area           String?
  snapshotAreaId String?  // areaId saat transaksi dibuat (tidak berubah meski user rotasi)
  commodity      String?
  cbReference    String?
  problem        String?
  plan           String?
  status         String   @default("SUBMITTED") // "SUBMITTED", "APPROVED_SPV", "APPROVED_FAM", "APPROVED_WHM", "APPROVED", "REJECTED", "DEMO_PLOT_SELESAI"
  rejectReason   String?  // Keterangan/alasan penolakan (diisi oleh approver saat reject)
  accurateInvoiceNo String? // Nomor faktur dari Accurate Online (terisi saat SPV terima stok)
  warehouseSource String? @default("MAIN") // "MAIN" (Accurate) | "SAMPLE" (Gudang Sampel SPV)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  details        RequestDetail[]
  demoPlots      DemoPlot[]

  @@index([foId, status])
  @@index([afaId, status])
  @@index([status, createdAt])
}

model SampleLedger {
  id              String   @id @default(cuid())
  userId          String   // SPV pemilik gudang sampel
  user            User     @relation(fields: [userId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Float    // + masuk (SAMPLE_IN), - keluar (SAMPLE_OUT)
  transactionType String   // "SAMPLE_IN" | "SAMPLE_OUT"
  notes           String?
  referenceId     String?  // requestId jika keluar ke AFA
  createdAt       DateTime @default(now())

  @@index([userId, productId])
  @@index([referenceId])
}

model RequestDetail {
  id             String   @id @default(cuid())
  requestId      String
  request        Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  
  qtyRequested      Float
  qtyApproved       Float?
  requestUnit       String?  // Satuan saat diajukan (ml, gr, Btl, dll) — agar tampilan konsisten
  accurateWarehouse String?  // Gudang sumber Accurate per-SKU (null = fallback ke 'Gudang Baik')

  @@index([requestId])
}

model DemoPlot {
  id             String   @id @default(cuid())
  requestId      String?
  request        Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  farmerId       String?
  farmer         Farmer?  @relation(fields: [farmerId], references: [id])
  
  date           DateTime
  area           String?
  snapshotAreaId String?  // areaId FO/user saat demplot dibuat
  commodity      String?
  cropAgeDays    Int?     // umur tanaman dalam HST (hari setelah tanam)
  landSize       Float?
  landSizeUnit   String?  // "ha" atau "m2"
  resultNotes    String?
  photos         String?  // JSON stringified array of URLs
  latitude       Float?
  longitude      Float?
  isFinalSession Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  details        DemoPlotDetail[]

  @@index([requestId])
  @@index([date])
  @@index([snapshotAreaId, date])
}

model DemoPlotDetail {
  id             String   @id @default(cuid())
  demoPlotId     String
  demoPlot       DemoPlot @relation(fields: [demoPlotId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  
  actualUsage          Float
  usedFarmerProduct    Boolean  @default(false) // true = produk milik petani, tidak memotong stok user

  @@index([demoPlotId])
}

model StockOpname {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  status         String   @default("SUBMITTED") // "SUBMITTED", "APPROVED", "REJECTED"
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  details        OpnameDetail[]

  @@index([userId, status])
}

model OpnameDetail {
  id             String   @id @default(cuid())
  opnameId       String
  opname         StockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  
  systemStock    Float
  physicalStock  Float
  variance       Float
  notes          String?

  @@index([opnameId])
}

// =======================
// ACTIVITY REPORTS
// =======================

model CustomerBehavior {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  
  snapshotAreaId String?  // areaId user saat record dibuat
  farmerName     String
  age            String?
  phone          String?
  address        String?
  district       String?
  commodity      String?
  reasonChoice   String?
  constraints    String?
  optTypes       String?  // JSON Array: ["Hama", "Penyakit", "Gulma"]
  optDetails     String?  // JSON Array: ["Wereng", "Kutu", "Jamur"]
  usedProducts   String?  // Biotis/Non-biotis
  buyLocation    String?  // Kios tempat membeli
  buyReason      String?
  references     String?
  notes          String?
  photos         String?  // URL foto dokumentasi (JSON Array)
  totalLandArea     Float?   // Luas lahan total petani
  totalLandAreaUnit String?  // "ha" atau "m2"
  latitude       Float?
  longitude      Float?
  
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([snapshotAreaId, createdAt])
  @@index([createdAt])
}

model VisitKios {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  snapshotAreaId String?  // areaId user saat visit dibuat
  
  kiosName       String
  activityDetail String?
  visitResult    String?
  notes          String?
  photos         String?  // URL foto dokumentasi (JSON Array)
  
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([snapshotAreaId, createdAt])
}

model FarmerGathering {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  snapshotAreaId String?  // areaId user saat gathering dibuat
  
  address        String?
  district       String?
  leaderName     String?
  phone          String?
  activityDetail String?
  cost           Float?
  costDetail     String?
  photos         String?  // URL foto dokumentasi (JSON Array)
  latitude       Float?   // Koordinat GPS lokasi gathering
  longitude      Float?   // Koordinat GPS lokasi gathering
  
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([snapshotAreaId, createdAt])
}

model VisitCompany {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  snapshotAreaId   String?  // areaId user saat visit dibuat
  
  companyName      String
  district         String?
  address          String?
  picName          String?
  picPosition      String?
  picPhone         String?
  landArea         String?
  commodities      String?  // JSON Array: ["Padi", "Jagung"]
  products         String?
  procurementDate  DateTime?
  paymentTerm      String?  // "COD", "CBD", "TOP<30 HARI", "TOP>30 HARI"
  photos           String?  // URL foto dokumentasi (JSON Array)
  
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([snapshotAreaId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   
  link      String?
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model SpotDemplot {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  
  snapshotAreaId    String?  // areaId user saat spot demplot dibuat
  districtDesa      String?
  districtKec       String?
  districtKab       String?
  weeds             String?  // JSON Array or string
  date              DateTime
  observationResult String?
  latitude          Float?
  longitude         Float?
  photos            String?  // JSON Array of URLs
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  details           SpotDemplotDetail[]

  @@index([userId, date])
  @@index([snapshotAreaId, date])
  @@index([createdAt])
}

model SpotDemplotDetail {
  id             String      @id @default(cuid())
  spotDemplotId  String
  spotDemplot    SpotDemplot @relation(fields: [spotDemplotId], references: [id], onDelete: Cascade)
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  usage                Float
  usedFarmerProduct    Boolean  @default(false) // true = produk milik petani, tidak memotong stok user

  @@index([spotDemplotId])
}

model ContentVideo {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  snapshotAreaId String?
  
  uploadDate     DateTime
  theme          String
  notes          String?
  photos         String?  // JSON Array of URLs
  
  createdAt      DateTime @default(now())
  
  products       ContentVideoProduct[]

  @@index([userId, createdAt])
  @@index([snapshotAreaId, createdAt])
}

model ContentVideoProduct {
  id              String       @id @default(cuid())
  contentVideoId  String
  contentVideo    ContentVideo @relation(fields: [contentVideoId], references: [id], onDelete: Cascade)
  productId       String
  product         Product      @relation(fields: [productId], references: [id])

  @@index([contentVideoId])
}

// =======================
// SOP (Standard Operating Procedure)
// =======================

model Sop {
  id          String   @id @default(cuid())
  title       String
  fileUrl     String   // Cloudinary PDF URL
  fileName    String?  // Original file name
  category    String   // e.g. "Gudang", "Lapangan", "Administrasi"
  isPublished Boolean  @default(true)

  authorId    String
  author      User     @relation(fields: [authorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SopCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// OPEN API KEY MANAGEMENT
// =======================

model ApiKey {
  id          String    @id @default(cuid())
  name        String    // Nama aplikasi konsumen (mis. "Garda Lapang")
  keyHash     String    @unique // SHA-256 hash dari full key
  keyPrefix   String    // Prefix untuk display, mis. "sk_wD3sgttYj........"
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime? // Kapan key terakhir digunakan untuk request
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([keyHash])
}

// =======================
// SIMOTANDI — Fase Tanam Padi (sumber: simotandi.pertanian.go.id)
// Hanya provinsi Jawa Tengah (33), DI Yogyakarta (34), Jawa Timur (35)
// =======================

model SimotandiPeriode {
  id        Int      @id          // nilai periode dari SIMOTANDI, mis. 51
  kode      String                // kode periode, mis. "202621"
  label     String                // "202621 | 29 Agustus 2026 - 09 September 2026"
  startDate DateTime?
  endDate   DateTime?
  syncedAt  DateTime @default(now())
  rows      SimotandiWilayah[]

  @@index([kode])
}

model SimotandiWilayah {
  id             String @id @default(cuid())
  periodeId      Int
  level          String // provinsi | kabupaten | kecamatan
  nama           String
  kdpr           String // kode provinsi BPS, mis. "33"
  kdkb           String? // kode kabupaten BPS, mis. "3307"
  kdkc           String? // kode kecamatan BPS, mis. "330701"

  bera           Float
  penyiapanLahan Float
  tanam          Float // tanam_1_12_hst
  veg1           Float // veg_1_13_36_hst
  veg2           Float // veg_2_37_60_hst
  gen1           Float // gen_1_61_84_hst
  gen2           Float // gen_2_85_110_hst
  panen          Float
  standingCrop   Float
  lsb            Float

  periode SimotandiPeriode @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  @@unique([periodeId, level, kdkb, kdkc])
  @@index([periodeId, level])
  @@index([kdkb])
  @@index([kdkc])
}

// =======================
// SALES DASHBOARD SYNC (Demoplot Impact Analytics)
// =======================

model DashboardCustomer {
  id              String   @id // id dari Sales Dashboard (UUID)
  accurateId      String?  @map("accurate_id")
  customerNo      String?  @map("customer_no")
  name            String
  city            String?
  region          String?
  defaultSalesman String?  @map("default_salesman")
  latitude        Float?
  longitude       Float?
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dashboard_customers")
  @@index([name])
}

model DashboardInvoice {
  id              String   @id @map("id_invoice") // no faktur dari Sales Dashboard (mis. "645.26.09.13307")
  customerId      String?  @map("customer_id")
  namaToko        String?  @map("nama_toko")
  namaSales       String?  @map("nama_sales")
  tanggal         DateTime
  status          String?  // jika "Retur", nilai omset/qty diperlakukan minus
  omset           Float    @default(0)
  items           Json     // array item transaksi [{ item_no, item_name, quantity, unit, unit_price, total_price }]
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dashboard_invoices")
  @@index([customerId])
  @@index([namaToko])
  @@index([tanggal])
}

// =======================
// SYNC AUDIT & MONITORING LOG
// =======================

model SyncLog {
  id             String    @id @default(cuid())
  dataType       String    @map("data_type") // e.g. "Transaksi SO & Invoice", "Master Data Pelanggan", "Master Data Barang (Stok & Harga)", "Fase Padi (SIMOTANDI)"
  triggerType    String    @default("MANUAL") @map("trigger_type") // "MANUAL" | "OTOMATIS"
  status         String    // "SUCCESS" | "FAILED" | "RUNNING"
  processedCount Int       @default(0) @map("processed_count")
  message        String?
  errorDetail    String?   @map("error_detail")
  durationMs     Int?      @map("duration_ms")
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("sync_logs")
  @@index([dataType])
  @@index([status])
  @@index([startedAt])
}

// Daftar Produk Fokus / Pengembangan (Opportunity Finder di Analitik Demplot).
// Global (bukan per user). Dicocokkan ke nama item invoice Sales Dashboard (SKU Accurate).
model DevelopmentProduct {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique @map("name_key") // nama ternormalisasi, untuk cegah duplikat
  code        String?  // no_barang / SKU Accurate (opsional)
  targetCrop  String?  @map("target_crop")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("development_products")
  @@index([isActive])
}
